# ============================================================
#  花店全渠道经营数据分析平台 · 环境变量模板
#  使用方式：双击 04_MySQL数仓_20261120/00_一键初始化数据库.bat
#            脚本会自动生成本文件（.env），并写入随机专用账号密码。
# ============================================================

# ---- MySQL 连接（应用专用账号，非 root） ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bloom_app
MYSQL_PASSWORD=请替换为初始化脚本生成的密码

# ---- 两个逻辑库 ----
MYSQL_OLTP_DB=bloom_oltp
MYSQL_DW_DB=bloom_dw

# ---- 数据生成参数（固定种子保证可复现） ----
BLOOM_SEED=20241118
BLOOM_DATA_START=2024-01-01
BLOOM_DATA_END=2026-11-18
